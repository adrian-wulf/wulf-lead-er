# WULF LEAD.ER - Przykładowa konfiguracja środowiska (.env)
# Skopiuj ten plik jako .env i uzupełnij własne wartości:
# cp .env.example .env

# Opcjonalny klucz Google AI Studio (Gemini 3.8 Flash z Google Grounding)
# Klucz można również podać bezpośrednio w interfejsie Web GUI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Opcjonalny token do polskiego rejestru CEIDG (dane.biznes.gov.pl)
CEIDG_API_TOKEN=

# Opcjonalna ścieżka do pliku z serwerami proxy (domyślnie: data/proxies.txt)
# PROXIES_FILE=data/proxies.txt

# Opcjonalne wyłączenie limitu zapytań (np. do testów automatycznych)
# DISABLE_RATE_LIMIT=0
